# Studio Jannah — usage local uniquement (scripts `pnpm veille:list` / `pnpm veille:search`)
#
# SUPABASE_SERVICE_ROLE_KEY bypass la RLS (accès total à la base) — jamais
# côté client, jamais commité (.env est dans .gitignore). Project Settings →
# API → service_role (secret), même projet que apps/web/.env et apps/app/.env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GEMINI_API_KEY : optionnelle pour `pnpm veille:search`, obligatoire pour
# `pnpm expertise:generate` et `pnpm blog:generate`. Même valeur que le
# secret Supabase GEMINI_API_KEY déjà utilisé par les Edge Functions
# admin-veille-filter / admin-generate-content / admin-veille-chat
# (Dashboard Supabase → Edge Functions → Secrets — la valeur est
# réutilisable, pas à régénérer).
GEMINI_API_KEY=your_gemini_api_key

# GEMINI_API_KEY_2, GEMINI_API_KEY_3... : facultatives. Une clé d'un second
# (troisième...) projet Google AI Studio, chacune avec son propre quota
# gratuit journalier indépendant — expertise-generate.mjs et
# blog-generate.mjs basculent automatiquement dessus si la première clé
# est à quota (voir docs/CONTENT_AUTO_FEED.md). Pas besoin de toucher à la
# ligne GEMINI_API_KEY ci-dessus, juste ajouter une ligne de plus.
# GEMINI_API_KEY_2=your_second_gemini_api_key
