# Studio Jannah — usage local uniquement (scripts `pnpm veille:list` / `pnpm veille:search`)
#
# SUPABASE_SERVICE_ROLE_KEY bypass la RLS (accès total à la base) — jamais
# côté client, jamais commité (.env est dans .gitignore). Project Settings →
# API → service_role (secret), même projet que apps/web/.env et apps/app/.env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GEMINI_API_KEY : optionnelle, seulement pour `pnpm veille:search`. Même
# valeur que le secret Supabase GEMINI_API_KEY déjà utilisé par les Edge
# Functions admin-veille-filter / admin-generate-content (Dashboard Supabase
# → Edge Functions → Secrets — la valeur est réutilisable, pas à régénérer).
GEMINI_API_KEY=your_gemini_api_key
