{
  "name": "studio-jannah",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @studio-jannah/web dev",
    "dev:app": "pnpm --filter @studio-jannah/app dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @studio-jannah/web build",
    "build:app": "pnpm --filter @studio-jannah/app build",
    "preview": "pnpm --filter @studio-jannah/web preview",
    "sync:cmp": "pnpm --filter @studio-jannah/web sync:cmp",
    "lint": "pnpm -r run lint --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@^4"
    }
  }
}
