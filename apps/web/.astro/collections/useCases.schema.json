{
  "$ref": "#/definitions/useCases",
  "definitions": {
    "useCases": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "published"
          ]
        },
        "sector": {
          "type": "string"
        },
        "complexity": {
          "type": "string",
          "enum": [
            "medium",
            "high",
            "expert"
          ]
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "placeholderBrand": {
          "type": "boolean",
          "default": true
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "publishedAt",
        "status",
        "sector",
        "complexity"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}