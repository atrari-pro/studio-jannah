---
import { getCollection } from "astro:content";
import { blogRubriques, site } from "@studio-jannah/shared";
import { withBase } from "../lib/paths";

const articles = (await getCollection("insights", ({ data }) => data.status === "published")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const teaser = articles.slice(0, 3);
const blog = site.blog;
const rubriqueLabel = (id: string) => blogRubriques.find((r) => r.id === id)?.label ?? id;
---

<section class="blog-home section" id="blog" aria-labelledby="blog-home-title">
  <div class="wrap">
    <div class="blog-home__head">
      <div>
        <p class="eyebrow">{blog.name}</p>
        <h2 class="section-title" id="blog-home-title">{blog.headline}</h2>
        <p class="section-lead">{blog.tagline}</p>
      </div>
      <a
        class="btn btn-ghost"
        href={withBase("/blog")}
        data-track-cta="home_blog_all"
        data-track-label="Ouvrir le Blog"
      >
        Ouvrir le Blog
      </a>
    </div>

    {
      teaser.length > 0 && (
        <ul class="blog-home__cards">
          {teaser.map((item) => (
            <li>
              <a
                href={withBase(`/blog/${item.id}`)}
                data-track-cta={`home_blog_${item.id}`}
                data-track-label={item.data.title}
              >
                <span class="blog-home__meta">
                  {rubriqueLabel(item.data.rubrique)}
                  <span aria-hidden="true">·</span>
                  {item.data.format === "video" ? "Vidéo" : "Texte"}
                </span>
                <span class="blog-home__title">{item.data.title}</span>
                <span class="blog-home__hook">{item.data.hook}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .blog-home {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--sj-mist) 35%, var(--sj-paper)) 0%,
      var(--sj-paper) 100%
    );
  }

  .blog-home__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .blog-home__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 860px) {
    .blog-home__cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.15rem;
    }
  }

  .blog-home__cards a {
    display: grid;
    gap: 0.55rem;
    height: 100%;
    padding: 1.25rem 1.1rem;
    border: 1px solid var(--sj-line);
    background: var(--sj-paper-elevated);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.25s var(--sj-ease),
      background 0.25s var(--sj-ease);
  }

  .blog-home__cards a:hover {
    border-color: color-mix(in oklab, var(--sj-garden) 45%, var(--sj-line));
    background: var(--sj-paper);
    color: inherit;
  }

  .blog-home__meta {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--sj-garden);
  }

  .blog-home__title {
    font-family: var(--sj-font-display);
    font-weight: 750;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .blog-home__hook {
    color: var(--sj-muted);
    font-size: 0.95rem;
  }
</style>
