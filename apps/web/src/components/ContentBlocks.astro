---
import { getCollection } from "astro:content";
import { site } from "@studio-jannah/shared";
import { withBase } from "../lib/paths";
import BlogCard from "./BlogCard.astro";

const articles = (await getCollection("insights", ({ data }) => data.status === "published")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const teaser = articles.slice(0, 3);
const blog = site.blog;
---

<section class="blog-home section" id="blog" aria-labelledby="blog-home-title">
  <div class="wrap">
    <div class="blog-home__head">
      <div>
        <p class="eyebrow">{blog.name}</p>
        <h2 class="section-title" id="blog-home-title">{blog.headline}</h2>
        <p class="section-lead">{blog.tagline}</p>
      </div>
      <a
        class="btn btn-ghost"
        href={withBase("/blog")}
        data-track-cta="home_blog_all"
        data-track-label="Ouvrir le Blog"
      >
        Ouvrir le Blog
      </a>
    </div>

    {
      teaser.length > 0 && (
        <ul class="blog-home__cards">
          {teaser.map((item) => (
            <li>
              <BlogCard
                id={item.id}
                title={item.data.title}
                description={item.data.hook}
                rubrique={item.data.rubrique}
                format={item.data.format}
                theme="light"
                ctaZone="home_blog"
              />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .blog-home {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--sj-mist) 35%, var(--sj-paper)) 0%,
      var(--sj-paper) 100%
    );
  }

  .blog-home__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .blog-home__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 860px) {
    .blog-home__cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.15rem;
    }
  }

  /* .blog-card* (variante --light) : voir components/BlogCard.astro. */
</style>
