---
/**
 * ConsentBoot — CMP après runtime DL (/sj/datalayer.js).
 * Ne réassigne jamais dataLayer ; pousse sj_cmp_ready + met à jour consent via window.sj.
 *
 * Une seule finalité réelle au-delà des cookies essentiels : la mesure
 * d'audience (GTM + dataLayer). Un seul toggle, un seul service — pas de
 * catégories fantômes (Ads/Piano/Bing) non utilisées par ce site.
 */
import { withBase } from "../lib/paths";

interface Props {
  privacyUrl?: string;
}

const { privacyUrl = "/politique-confidentialite" } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? "";
const privacyHref = withBase(privacyUrl);
const tacCss = withBase("/tarteaucitron/css/tarteaucitron.css");
const cmpCss = withBase("/styles/cmp-jannah.css");
const tacJs = withBase("/tarteaucitron/tarteaucitron.js");
---

<!-- Consent Mode v2 — push Arguments dans le dataLayer EXISTANT (jamais de reset) -->
<script is:inline>
  (function () {
    if (!Array.isArray(window.dataLayer)) window.dataLayer = [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "granted",
      personalization_storage: "denied",
      security_storage: "granted",
      wait_for_update: 500,
    });
  })();
</script>

<link rel="stylesheet" href={tacCss} />
<link rel="stylesheet" href={cmpCss} />

<!--
  Surcharge des textes par défaut de tarteaucitron (générique, hors voix de
  marque — ex. "☝️ 🍪" et le crédit "Gestion des cookies par tarteaucitron.js").
  Doit être déclarée AVANT le chargement du script principal : la lib lit
  `tarteaucitronCustomText` en variable globale à son évaluation et la
  fusionne (deep merge) dans tarteaucitron.lang une fois le fichier de langue
  chargé (mécanisme officiel — ne pas éditer le fichier lang vendu, écrasé à
  chaque `pnpm sync:cmp`). Langage simple et exact plutôt que le générique
  "peut installer des cookies" : un seul service réel, on le dit tel quel.
-->
<script is:inline>
  window.tarteaucitronCustomText = {
    middleBarHead: "Vos préférences",
    alertBigPrivacy:
      "Un seul service optionnel : la mesure d'audience. Refuser est aussi simple qu'accepter.",
    icon: "Préférences cookies",
    disclaimer: "Détail du service ci-dessous. Rien d'autre sans votre accord.",
    analytic: {
      title: "Mesure d'audience",
      details:
        "dataLayer Studio Jannah via Google Tag Manager, pour comprendre la fréquentation. Aucune publicité, aucune revente de données.",
    },
    mandatoryTitle: "Cookies essentiels",
    mandatoryText:
      "Nécessaires au fonctionnement du site (mémorisation de votre choix). Ils ne mesurent rien et ne peuvent pas être désactivés.",
  };
</script>

<script
  is:inline
  src={tacJs}
  data-privacy={privacyHref}
  data-gtm={gtmId}
  data-tac={tacJs}
></script>
<script is:inline>
  (function () {
    var marker = document.querySelector("script[data-tac]");
    var privacyUrl =
      (marker && marker.getAttribute("data-privacy")) || "/politique-confidentialite";
    var gtmId = (marker && marker.getAttribute("data-gtm")) || "";
    var gtmLoaded = false;

    function dl() {
      if (window.sj && window.sj.ensureDataLayer) return window.sj.ensureDataLayer();
      if (!Array.isArray(window.dataLayer)) window.dataLayer = [];
      return window.dataLayer;
    }

    if (typeof tarteaucitron === "undefined") {
      console.warn("[Studio Jannah] tarteaucitron non chargé — pnpm sync:cmp");
      return;
    }

    tarteaucitron.init({
      privacyUrl: privacyUrl,
      bodyPosition: "top",
      hashtag: "#cookies",
      cookieName: "sj_consent",
      orientation: "middle",
      // false : une seule catégorie a un service réel (analytic), le
      // toggle "groupe" ferait doublon avec le toggle du service lui-même.
      groupServices: false,
      showDetailsOnClick: true,
      serviceDefaultState: "wait",
      showAlertSmall: false,
      cookieslist: true,
      closePopup: false,
      showIcon: true,
      // BottomRight : le footer place Confidentialité/Cookies/Admin en bas à
      // gauche, or l'icône CMP est fixed avec un z-index quasi-max
      // (2147483646, cf. tarteaucitron.css) — en BottomLeft elle recouvrait
      // et bloquait les clics sur ces liens, notamment "Admin" sur mobile.
      iconPosition: "BottomRight",
      adblocker: false,
      DenyAllCta: true,
      AcceptAllCta: true,
      highPrivacy: true,
      alwaysNeedConsent: false,
      handleBrowserDNTRequest: false,
      removeCredit: true,
      moreInfoLink: true,
      useExternalCss: true,
      useExternalJs: false,
      readmoreLink: privacyUrl,
      mandatory: true,
      mandatoryCta: true,
      // Consent Mode v2 est géré nous-mêmes (voir service sjanalytics
      // ci-dessous) : un seul appel gtag("consent", "update", ...) par
      // changement, une seule source de vérité. Le module natif de
      // tarteaucitron ferait un second `gtag('consent','default',...)`
      // concurrent (wait_for_update différent, clés partielles) — désactivé
      // pour éviter deux implémentations qui se marchent dessus.
      googleConsentMode: false,
      // Piano Analytics / Bing Ads-Clarity : aucun des deux n'est utilisé sur
      // ce site. Les laisser à true injecte des stubs globaux (window.pdl,
      // window.uetq, window.clarity) et des listeners pour des vendeurs
      // fantômes — bruit pur, désactivé.
      bingConsentMode: false,
      pianoConsentMode: false,
      softConsentMode: false,
      dataLayer: true,
      serverSide: false,
      partnersList: false,
    });

    // Service unique : mesure d'audience. Regroupe volontairement ce que
    // tarteaucitron sépare par défaut (son service "googletagmanager" est de
    // type "api", donc affiché dans une catégorie différente de "analytic")
    // — ici un seul toggle contrôle à la fois le chargement du conteneur GTM
    // et notre flag interne, pour éviter l'incohérence "mesure autorisée
    // mais GTM jamais chargé" (ou l'inverse) et une UI à deux cases pour une
    // seule finalité réelle.
    tarteaucitron.services.sjanalytics = {
      key: "sjanalytics",
      type: "analytic",
      name: "Mesure d'audience (Google Tag Manager)",
      needConsent: true,
      cookies: [],
      readmoreLink: privacyUrl,
      js: function () {
        // Source de vérité unique pour Consent Mode v2 — sans cet appel,
        // analytics_storage restait "denied" à vie côté GTM même après un
        // clic sur "Tout accepter" (gap constaté à l'audit : le service ne
        // poussait qu'un événement dataLayer interne, jamais l'update gtag).
        if (window.gtag) {
          window.gtag("consent", "update", { analytics_storage: "granted" });
        }

        if (gtmId && !gtmLoaded) {
          gtmLoaded = true;
          var layer = dl();
          layer.push({ "gtm.start": Date.now(), event: "gtm.js" });
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtmId;
          document.head.appendChild(s);
        }

        if (window.sj && window.sj.setConsent) {
          window.sj.setConsent(true, false, "tarteaucitron_sjanalytics");
        } else {
          dl().push({
            event: "sj_consent_update",
            consent_analytics: true,
            consent_source: "tarteaucitron_sjanalytics_fallback",
            event_ts: Date.now(),
            schema_version: "1.0.0",
            brand: "studio_jannah",
          });
        }
      },
      fallback: function () {
        if (window.gtag) {
          window.gtag("consent", "update", { analytics_storage: "denied" });
        }
        if (window.sj && window.sj.setConsent) {
          window.sj.setConsent(false, false, "tarteaucitron_sjanalytics_deny");
        }
      },
    };
    (tarteaucitron.job = tarteaucitron.job || []).push("sjanalytics");

    if (window.sj && window.sj.push) {
      window.sj.push({
        event: "sj_cmp_ready",
        cmp_name: "tarteaucitron",
        cmp_id: "sj_consent",
      });
    } else {
      dl().push({
        event: "sj_cmp_ready",
        cmp_name: "tarteaucitron",
        cmp_id: "sj_consent",
        event_ts: Date.now(),
        schema_version: "1.0.0",
        brand: "studio_jannah",
      });
    }

    document.addEventListener(
      "click",
      function (e) {
        var el = e.target && e.target.closest ? e.target.closest("[data-open-cmp]") : null;
        if (!el) return;
        e.preventDefault();
        if (tarteaucitron && tarteaucitron.userInterface) {
          tarteaucitron.userInterface.openPanel();
        }
      },
      false,
    );
  })();
</script>
