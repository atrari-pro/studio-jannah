---
/**
 * ConsentBoot — CMP après runtime DL (/sj/datalayer.js).
 * Ne réassigne jamais dataLayer ; pousse sj_cmp_ready + met à jour consent via window.sj.
 *
 * Moteur : vanilla-cookieconsent (Orest Bida, MIT — https://github.com/orestbida/cookieconsent).
 * Remplace tarteaucitron.js (voir docs/CMP_DECISION.md pour l'historique de
 * l'arbitrage) : lib pensée pour être personnalisée (théming par CSS custom
 * properties, zéro !important nécessaire côté site), bundlée via npm/Vite au
 * lieu d'un vendor self-hébergé copié à chaque build.
 *
 * Une seule finalité réelle au-delà des cookies essentiels : la mesure
 * d'audience (GTM + dataLayer). Une seule catégorie "analytics", un seul
 * toggle — pas de sous-niveau "service" (la lib permet de nicher des
 * services par catégorie, inutile ici : un seul service seul par catégorie
 * ne fait que dupliquer le toggle de la catégorie elle-même).
 */
import { withBase } from "../lib/paths";

interface Props {
  privacyUrl?: string;
}

const { privacyUrl = "/politique-confidentialite" } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? "";
const privacyHref = withBase(privacyUrl);
---

<!-- Icône flottante de réouverture — la lib n'en fournit pas nativement
     (contrairement à tarteaucitron qui l'injectait via showIcon:true) ; sans
     elle, seul le lien "Cookies" du footer permet de rouvrir le panneau, pas
     assez visible pendant la navigation. Réutilise le même mécanisme
     data-open-cmp que ce lien (voir listener plus bas). Toujours dans le
     DOM (pas injectée par la CMP), donc jamais de flash au chargement. -->
<button type="button" id="sj-cmp-reopen" data-open-cmp aria-label="Préférences cookies" title="Préférences cookies">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <line x1="4" y1="7" x2="20" y2="7"></line>
    <circle cx="9" cy="7" r="2" fill="currentColor" stroke="none"></circle>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <circle cx="15" cy="12" r="2" fill="currentColor" stroke="none"></circle>
    <line x1="4" y1="17" x2="20" y2="17"></line>
    <circle cx="7" cy="17" r="2" fill="currentColor" stroke="none"></circle>
  </svg>
</button>

<!-- Consent Mode v2 — push Arguments dans le dataLayer EXISTANT (jamais de reset).
     Doit rester is:inline + synchrone : posé avant tout script tiers, y
     compris avant l'import (bundlé, donc légèrement différé) de la CMP. -->
<script is:inline>
  (function () {
    if (!Array.isArray(window.dataLayer)) window.dataLayer = [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "granted",
      personalization_storage: "denied",
      security_storage: "granted",
      wait_for_update: 500,
    });
  })();
</script>

<!-- Valeurs serveur → global lisible par le script module ci-dessous. Un
     script `is:inline` avec define:vars ne peut pas contenir d'`import` (pas
     traité par Vite) : on passe donc par window plutôt que d'inliner ces
     valeurs directement dans le module. -->
<script is:inline define:vars={{ gtmId, privacyHref }}>
  window.__sjCmpConfig = { gtmId: gtmId, privacyHref: privacyHref };
</script>

<script>
  import * as CookieConsent from "vanilla-cookieconsent";
  import "vanilla-cookieconsent/dist/cookieconsent.css";
  import "../styles/cmp-jannah.css";

  const cfg = window.__sjCmpConfig || {};
  const gtmId = cfg.gtmId || "";
  const privacyHref = cfg.privacyHref || "/politique-confidentialite";

  function dl() {
    if (window.sj && window.sj.ensureDataLayer) return window.sj.ensureDataLayer();
    if (!Array.isArray(window.dataLayer)) window.dataLayer = [];
    return window.dataLayer;
  }

  let gtmLoaded = false;

  function loadGtm() {
    if (!gtmId || gtmLoaded) return;
    gtmLoaded = true;
    var layer = dl();
    layer.push({ "gtm.start": Date.now(), event: "gtm.js" });
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtmId;
    document.head.appendChild(s);
  }

  // Source de vérité unique pour Consent Mode v2 + window.sj — appelée par
  // onFirstConsent (premier choix), onConsent (rappelé à CHAQUE chargement
  // de page si le consentement est déjà valide — pas seulement au premier
  // accord, contrairement à l'ancienne intégration TAC) et onChange
  // (modification via le panneau). Un seul accord "premier + réel" déclenche
  // à la fois onFirstConsent ET onConsent ET onChange — sans garde, le push
  // sj_consent_update part 2-3 fois pour une seule action utilisateur.
  // lastGranted la limite au push dataLayer uniquement (bruit à éviter) :
  // gtag reste appelé à chaque fois (idempotent côté Consent Mode, et c'est
  // justement ce qui garantit l'état gtag réaffirmé à chaque chargement de
  // page, gtag n'ayant pas de mémoire entre deux chargements).
  var lastGranted;

  function syncConsent() {
    var granted = CookieConsent.acceptedCategory("analytics");
    if (granted) loadGtm();
    if (window.gtag) {
      window.gtag("consent", "update", { analytics_storage: granted ? "granted" : "denied" });
    }
    if (granted === lastGranted) return;
    lastGranted = granted;
    if (window.sj && window.sj.setConsent) {
      window.sj.setConsent(granted, false, "cookieconsent_analytics");
    } else {
      dl().push({
        event: "sj_consent_update",
        consent_analytics: granted,
        consent_source: "cookieconsent_analytics_fallback",
        event_ts: Date.now(),
        schema_version: "1.2.0",
        brand: "studio_jannah",
      });
    }
  }

  // Nettoyage — l'ancienne CMP (tarteaucitron) utilisait déjà le nom de
  // cookie "sj_consent" (format `!sjanalytics=true!...`, pas du JSON). Un
  // visiteur revenant après la migration porte donc un cookie "sj_consent"
  // dont la valeur fait échouer le JSON.parse interne de la lib — l'erreur
  // est absorbée silencieusement, mais avec pour effet que le consentement
  // n'est JAMAIS relu : le bandeau se réaffichait à CHAQUE chargement de page
  // pour tout visiteur ayant connu l'ancienne CMP (bug constaté sur le site
  // déployé). Cookie renommé sur un nom neuf (sj_cmp_consent) pour éliminer
  // toute collision, + expiration défensive de l'ancien nom sur les chemins
  // plausibles pour ne pas le laisser traîner indéfiniment.
  ["/", "/studio-jannah/", "/studio-jannah", location.pathname].forEach(function (p) {
    document.cookie = "sj_consent=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=" + p;
  });

  await CookieConsent.run({
    // sj_cmp_consent (pas sj_consent, pas le cc_cookie par défaut de la lib)
    // — voir le nettoyage ci-dessus pour pourquoi ce nom a changé.
    cookie: { name: "sj_cmp_consent" },
    // Fond assombri + scroll bloqué tant qu'aucun choix n'est fait — même
    // traitement "moment plein écran" que l'ancienne intégration TAC.
    disablePageInteraction: true,
    guiOptions: {
      consentModal: {
        layout: "box",
        position: "middle center",
        // false : Accepter reste plein (vert), Refuser passe en contour —
        // même gabarit (taille, padding) donc même poids réel, mais
        // visuellement distincts. equalWeightButtons:true (défaut lib) les
        // rend TOUS deux pleins verts, impossible à distinguer au survol rapide.
        equalWeightButtons: false,
      },
      preferencesModal: { layout: "box", equalWeightButtons: false },
    },
    categories: {
      necessary: { readOnly: true, enabled: true },
      analytics: {},
    },
    language: {
      default: "fr",
      translations: {
        fr: {
          consentModal: {
            title: "Vos préférences",
            description:
              "Un seul service optionnel : la mesure d'audience. Refuser est aussi simple qu'accepter.",
            acceptAllBtn: "Tout accepter",
            acceptNecessaryBtn: "Tout refuser",
            showPreferencesBtn: "Personnaliser",
            footer: '<a href="' + privacyHref + '">Politique de confidentialité</a>',
          },
          preferencesModal: {
            title: "Préférences",
            acceptAllBtn: "Tout accepter",
            acceptNecessaryBtn: "Tout refuser",
            savePreferencesBtn: "Enregistrer",
            sections: [
              {
                title: "Cookies essentiels",
                description:
                  "Nécessaires au fonctionnement du site (mémorisation de votre choix). Ils ne mesurent rien et ne peuvent pas être désactivés.",
                linkedCategory: "necessary",
              },
              {
                title: "Mesure d'audience",
                description:
                  "dataLayer Studio Jannah via Google Tag Manager, pour comprendre la fréquentation. Aucune publicité, aucune revente de données.",
                linkedCategory: "analytics",
              },
            ],
          },
        },
      },
    },
    onFirstConsent: syncConsent,
    onConsent: syncConsent,
    onChange: syncConsent,
  });

  if (window.sj && window.sj.push) {
    window.sj.push({ event: "sj_cmp_ready", cmp_name: "cookieconsent", cmp_id: "sj_cmp_consent" });
  } else {
    dl().push({
      event: "sj_cmp_ready",
      cmp_name: "cookieconsent",
      cmp_id: "sj_cmp_consent",
      event_ts: Date.now(),
      schema_version: "1.2.0",
      brand: "studio_jannah",
    });
  }

  // Réouverture du panneau depuis n'importe quel lien [data-open-cmp]
  // (footer, page politique de confidentialité...).
  document.addEventListener(
    "click",
    function (e) {
      var el = e.target && e.target.closest ? e.target.closest("[data-open-cmp]") : null;
      if (!el) return;
      e.preventDefault();
      CookieConsent.showPreferences();
    },
    false,
  );

  // Deep-link #cookies (repris du hashtag de l'ancienne intégration) —
  // ouvre directement le panneau si on arrive avec cette ancre dans l'URL.
  if (location.hash === "#cookies") {
    CookieConsent.showPreferences();
  }
</script>

<style>
  #sj-cmp-reopen {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 999999;
    width: 48px;
    height: 48px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: var(--sj-garden);
    color: var(--sj-paper-elevated);
    cursor: pointer;
    box-shadow: 0 8px 24px color-mix(in oklab, var(--sj-ink) 25%, transparent);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  #sj-cmp-reopen:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px color-mix(in oklab, var(--sj-ink) 30%, transparent);
  }

  #sj-cmp-reopen:focus-visible {
    outline: 2px solid var(--sj-signal);
    outline-offset: 2px;
  }

  #sj-cmp-reopen svg {
    width: 22px;
    height: 22px;
  }
</style>
