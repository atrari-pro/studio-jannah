---
import { capabilities } from "@studio-jannah/shared";
import { withBase } from "../lib/paths";

const total = capabilities.length;
---

<section class="section expertises" id="expertises" aria-labelledby="exp-title">
  <div class="wrap">
    <p class="eyebrow">{total} pratiques</p>
    <h2 class="section-title" id="exp-title">Pratiques</h2>
    <p class="section-lead">
      Collecte → mesure → activation → automatisation. L’aval ne tient que si
      l’amont tient. Exercées chez <a href="#marques">Cartier, Danone, AXA,
      SNCF, Paylib…</a> via fifty-five puis EY.
    </p>

    <div class="exp-grid">
      {
        capabilities.map((c, i) => (
          <article class="exp-card">
            <p class="exp-card__mark" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
            <div class="exp-card__top">
              <span class="exp-card__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="exp-card__disc">{c.discipline}</span>
            </div>
            <h3>{c.title}</h3>
            <p class="exp-card__summary">{c.summary}</p>
            <div class="exp-card__meta">
              <div>
                <p class="exp-card__label">Livrable</p>
                <p class="exp-card__deliver">{c.delivers}</p>
              </div>
              <div>
                <p class="exp-card__label">Stack</p>
                <p class="exp-card__stack">{c.stack.join(" · ")}</p>
              </div>
            </div>
            <ul class="exp-card__points">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="exp-cta">
      <a
        class="btn btn-ghost"
        href={withBase("/contact")}
        data-track-cta="expertises_contact"
        data-track-label="Discuter de votre cas"
      >
        Discuter de votre cas →
      </a>
    </p>
  </div>
</section>

<style>
  .expertises .section-lead a {
    color: var(--sj-ink);
    text-decoration-color: var(--sj-signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .expertises .section-lead a:hover {
    color: var(--sj-signal);
  }

  .exp-grid {
    display: grid;
    gap: 1.1rem;
    margin-top: 2.5rem;
  }

  .exp-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem 1.5rem 1.6rem;
    color: #f7f8f7;
    background: var(--sj-ink);
  }

  .exp-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 55% at 92% 8%,
        color-mix(in oklab, var(--sj-signal) 16%, transparent),
        transparent 60%
      ),
      radial-gradient(
        ellipse 50% 45% at 4% 96%,
        color-mix(in oklab, var(--sj-garden) 24%, transparent),
        transparent 55%
      );
    pointer-events: none;
  }

  .exp-card__mark {
    position: absolute;
    right: 0.35rem;
    top: 0.1rem;
    margin: 0;
    font-family: var(--sj-font-display);
    font-size: clamp(3.5rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: color-mix(in oklab, #f7f8f7 6%, transparent);
    pointer-events: none;
  }

  .exp-card__top,
  .exp-card h3,
  .exp-card__summary,
  .exp-card__meta,
  .exp-card__points {
    position: relative;
  }

  .exp-card__top {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
  }

  .exp-card__n {
    font-family: var(--sj-font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--sj-signal);
  }

  .exp-card__disc {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--sj-signal) 88%, #f7f8f7);
  }

  .exp-card h3 {
    margin: 0 0 0.75rem;
    max-width: 20ch;
    font-size: clamp(1.3rem, 2.2vw, 1.55rem);
  }

  .exp-card__summary {
    margin: 0 0 1.35rem;
    color: color-mix(in oklab, #f7f8f7 68%, transparent);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .exp-card__meta {
    display: grid;
    gap: 1rem;
    padding-top: 1.05rem;
    margin-bottom: 1.1rem;
    border-top: 1px solid color-mix(in oklab, #f7f8f7 12%, transparent);
  }

  .exp-card__label {
    margin: 0 0 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--sj-signal) 75%, #f7f8f7);
  }

  .exp-card__deliver,
  .exp-card__stack {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .exp-card__stack {
    color: color-mix(in oklab, #f7f8f7 82%, transparent);
  }

  .exp-card__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .exp-card__points li {
    padding: 0.3rem 0.6rem;
    border: 1px solid color-mix(in oklab, #f7f8f7 20%, transparent);
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 600;
    color: color-mix(in oklab, #f7f8f7 88%, transparent);
  }

  .exp-cta {
    margin: 2rem 0 0;
  }

  @media (min-width: 680px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1180px) {
    .exp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
