---
import { capabilities } from "@studio-jannah/shared";

const total = String(capabilities.length).padStart(2, "0");
---

<section class="section expertises" id="expertises" aria-labelledby="exp-title">
  <div class="wrap">
    <p class="eyebrow">Périmètre</p>
    <h2 class="section-title" id="exp-title">Pratiques</h2>
    <p class="section-lead">
      Collecte → mesure → activation → automatisation. Conseil et enablement
      en transverse. L’aval ne tient que si l’amont tient.
    </p>

    <div class="exp" data-exp>
      <div class="exp__index" role="tablist" aria-label="Pratiques">
        <i class="exp__rail" data-exp-rail aria-hidden="true"></i>
        {
          capabilities.map((c, i) => (
            <button
              type="button"
              class:list={["exp__tab", i === 0 && "is-on"]}
              role="tab"
              id={`exp-tab-${c.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`exp-pane-${c.id}`}
              data-exp-id={c.id}
            >
              <span class="exp__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="exp__tab-title">{c.title}</span>
              <span class="exp__tab-disc">{c.discipline}</span>
            </button>
          ))
        }
      </div>

      {
        capabilities.map((c, i) => (
          <div
            class:list={["exp__pane", i === 0 && "is-on"]}
            id={`exp-pane-${c.id}`}
            role="tabpanel"
            aria-labelledby={`exp-tab-${c.id}`}
            data-exp-pane={c.id}
            hidden={i !== 0}
          >
            <p class="exp__mark" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
            <div class="exp__pane-top">
              <p class="exp__disc">{c.discipline}</p>
              <p class="exp__count">
                <span>{String(i + 1).padStart(2, "0")}</span>
                <span aria-hidden="true">/</span>
                <span>{total}</span>
              </p>
            </div>
            <h3>{c.title}</h3>
            <p class="exp__summary">{c.summary}</p>
            <div class="exp__meta">
              <div>
                <p class="exp__label">Livrable</p>
                <p class="exp__deliver">{c.delivers}</p>
              </div>
              <div>
                <p class="exp__label">Stack</p>
                <p class="exp__stack">{c.stack.join(" · ")}</p>
              </div>
            </div>
            <p class="exp__levers">{c.points.map((p) => `— ${p}`).join("   ")}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-exp]");
  if (root) {
    const tabs = [...root.querySelectorAll("[data-exp-id]")];
    const panes = [...root.querySelectorAll("[data-exp-pane]")];
    const rail = root.querySelector("[data-exp-rail]");

    const pinRail = (tab) => {
      if (!rail || !(tab instanceof HTMLElement)) return;
      rail.style.top = `${tab.offsetTop}px`;
      rail.style.height = `${tab.offsetHeight}px`;
    };

    const show = (id) => {
      if (!id) return;
      let active = tabs[0];
      tabs.forEach((tab) => {
        const on = tab.getAttribute("data-exp-id") === id;
        tab.classList.toggle("is-on", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        if (on) active = tab;
      });
      panes.forEach((pane) => {
        const on = pane.getAttribute("data-exp-pane") === id;
        pane.toggleAttribute("hidden", !on);
        pane.classList.toggle("is-on", on);
        if (on) {
          pane.classList.remove("is-swap");
          void pane.offsetWidth;
          pane.classList.add("is-swap");
        }
      });
      pinRail(active);
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => show(tab.getAttribute("data-exp-id")));
    });

    pinRail(tabs[0]);
    window.addEventListener("resize", () => {
      const on = tabs.find((t) => t.classList.contains("is-on"));
      if (on) pinRail(on);
    });
  }
</script>

<style>
  .exp {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.75rem;
  }

  .exp__index {
    position: relative;
    padding-left: 1px;
  }

  .exp__index::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--sj-line);
  }

  .exp__rail {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    background: var(--sj-signal);
    box-shadow: 0 0 12px color-mix(in oklab, var(--sj-signal) 35%, transparent);
    transition:
      top 0.45s var(--sj-ease),
      height 0.45s var(--sj-ease);
    pointer-events: none;
  }

  .exp__tab {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    align-items: baseline;
    width: 100%;
    margin: 0;
    padding: 1.05rem 0.35rem 1.05rem 1.15rem;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .exp__n {
    grid-row: 1 / span 2;
    font-family: var(--sj-font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--sj-muted);
    transition: color 0.3s var(--sj-ease);
  }

  .exp__tab.is-on .exp__n,
  .exp__tab:hover .exp__n {
    color: var(--sj-signal);
  }

  .exp__tab-title {
    font-family: var(--sj-font-display);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .exp__tab-disc {
    margin-top: 0.15rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sj-muted);
  }

  .exp__pane {
    position: relative;
    overflow: hidden;
    min-height: 22rem;
    padding: 1.75rem 1.5rem 1.6rem;
    background: var(--sj-paper-elevated);
    box-shadow: inset 0 1px 0 color-mix(in oklab, var(--sj-signal) 45%, transparent);
  }

  .exp__pane[hidden] {
    display: none;
  }

  .exp__pane.is-swap {
    animation: exp-swap 0.45s var(--sj-ease) both;
  }

  @keyframes exp-swap {
    from {
      opacity: 0;
      transform: translate3d(0.75rem, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .exp__mark {
    position: absolute;
    right: 0.4rem;
    top: 0.2rem;
    margin: 0;
    font-family: var(--sj-font-display);
    font-size: clamp(5.5rem, 12vw, 8.5rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: color-mix(in oklab, var(--sj-ink) 5%, transparent);
    pointer-events: none;
  }

  .exp__pane-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }

  .exp__disc,
  .exp__count,
  .exp__label {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .exp__disc {
    color: var(--sj-signal);
  }

  .exp__count {
    color: var(--sj-muted);
  }

  .exp__count span:first-child {
    color: var(--sj-ink);
  }

  .exp__pane h3 {
    position: relative;
    margin: 0 0 0.9rem;
    max-width: 16ch;
    font-size: clamp(1.65rem, 3.2vw, 2.2rem);
  }

  .exp__summary {
    position: relative;
    margin: 0 0 1.6rem;
    max-width: 34rem;
    color: var(--sj-muted);
    font-size: 1.05rem;
  }

  .exp__meta {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding-top: 1.2rem;
    margin-bottom: 1.15rem;
    border-top: 1px solid var(--sj-line);
  }

  .exp__label {
    margin-bottom: 0.35rem;
    color: var(--sj-garden);
  }

  .exp__deliver,
  .exp__stack {
    margin: 0;
    font-size: 0.95rem;
  }

  .exp__stack {
    font-weight: 650;
    color: var(--sj-ink);
  }

  .exp__levers {
    position: relative;
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--sj-ink);
  }

  @media (min-width: 880px) {
    .exp {
      grid-template-columns: minmax(17rem, 0.82fr) minmax(0, 1.18fr);
      gap: 2.75rem;
      align-items: stretch;
    }

    .exp__pane {
      padding: 2.1rem 2rem 1.85rem;
    }

    .exp__meta {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp__pane.is-swap,
    .exp__rail {
      animation: none;
      transition: none;
    }
  }
</style>
