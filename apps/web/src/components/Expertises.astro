---
import { capabilities, methodSteps } from "@studio-jannah/shared";
import { withBase } from "../lib/paths";

const flowTokens = methodSteps.flatMap((s, i) =>
  i < methodSteps.length - 1 ? [s.title, "→"] : [s.title],
);
---

<section class="section expertises" id="expertises" aria-labelledby="exp-title">
  <div class="wrap">
    <p class="eyebrow">Savoir-faire</p>
    <h2 class="section-title" id="exp-title">Un métier, plusieurs entrées</h2>

    <div class="exp-flow" aria-hidden="true">
      {
        flowTokens.map((t) => (
          <span class:list={["exp-flow__item", t === "→" && "is-arrow"]}>{t}</span>
        ))
      }
      <span class="exp-flow__item is-arrow is-open">…</span>
    </div>

    <p class="section-lead">
      Quatre mouvements qui s’articulent selon le terrain — diagnostic,
      delivery, ou remise en état d’un existant qui fuit. Le sujet cadre
      l’entrée, pas l’inverse.
    </p>

    <div class="exp-grid">
      {
        capabilities.map((c) => (
          <article class="exp-card">
            <span class="exp-card__disc">{c.discipline}</span>
            <h3>{c.title}</h3>
            <p class="exp-card__summary">{c.summary}</p>
            <div class="exp-card__meta">
              <div>
                <p class="exp-card__label">Livrable</p>
                <p class="exp-card__deliver">{c.delivers}</p>
              </div>
              <div>
                <p class="exp-card__label">Stack</p>
                <p class="exp-card__stack">{c.stack.join(" · ")}</p>
              </div>
            </div>
            <ul class="exp-card__points">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }

      <a
        class="exp-card exp-card--open"
        href={withBase("/contact")}
        data-track-cta="expertises_contact"
        data-track-label="Cadrer ensemble"
      >
        <p class="exp-card--open__text">
          Votre sujet ne rentre dans aucune de ces cases ?
        </p>
        <p class="exp-card--open__cta">On cadre ensemble →</p>
      </a>
    </div>
  </div>
</section>

<style>
  .exp-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 1.5rem 0 1.15rem;
  }

  .exp-flow__item {
    font-family: var(--sj-font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--sj-line);
    border-radius: 99px;
    color: var(--sj-ink);
  }

  .exp-flow__item.is-arrow {
    padding: 0 0.15rem;
    border: 0;
    font-weight: 800;
    color: var(--sj-signal);
  }

  .exp-flow__item.is-open {
    opacity: 0.55;
  }

  .exp-grid {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
  }

  .exp-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem 1.5rem 1.6rem;
    color: #f7f8f7;
    background: var(--sj-ink);
  }

  .exp-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 55% at 92% 8%,
        color-mix(in oklab, var(--sj-signal) 16%, transparent),
        transparent 60%
      ),
      radial-gradient(
        ellipse 50% 45% at 4% 96%,
        color-mix(in oklab, var(--sj-garden) 24%, transparent),
        transparent 55%
      );
    pointer-events: none;
  }

  .exp-card__disc,
  .exp-card h3,
  .exp-card__summary,
  .exp-card__meta,
  .exp-card__points {
    position: relative;
  }

  .exp-card__disc {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--sj-signal) 88%, #f7f8f7);
  }

  .exp-card h3 {
    margin: 0 0 0.75rem;
    max-width: 20ch;
    font-size: clamp(1.3rem, 2.2vw, 1.55rem);
  }

  .exp-card__summary {
    margin: 0 0 1.35rem;
    color: color-mix(in oklab, #f7f8f7 68%, transparent);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .exp-card__meta {
    display: grid;
    gap: 1rem;
    padding-top: 1.05rem;
    margin-bottom: 1.1rem;
    border-top: 1px solid color-mix(in oklab, #f7f8f7 12%, transparent);
  }

  .exp-card__label {
    margin: 0 0 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--sj-signal) 75%, #f7f8f7);
  }

  .exp-card__deliver,
  .exp-card__stack {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .exp-card__stack {
    color: color-mix(in oklab, #f7f8f7 82%, transparent);
  }

  .exp-card__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .exp-card__points li {
    padding: 0.3rem 0.6rem;
    border: 1px solid color-mix(in oklab, #f7f8f7 20%, transparent);
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 600;
    color: color-mix(in oklab, #f7f8f7 88%, transparent);
  }

  .exp-card--open {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    background: transparent;
    border: 1.5px dashed var(--sj-line);
    color: var(--sj-ink);
    text-decoration: none;
    transition:
      border-color 0.25s var(--sj-ease),
      background 0.25s var(--sj-ease);
  }

  .exp-card--open:hover {
    border-color: var(--sj-signal);
    background: color-mix(in oklab, var(--sj-signal) 5%, transparent);
  }

  .exp-card--open__text {
    margin: 0;
    max-width: 22ch;
    font-size: 0.98rem;
    color: var(--sj-muted);
  }

  .exp-card--open__cta {
    margin: 0;
    font-family: var(--sj-font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  @media (min-width: 680px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1180px) {
    .exp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
