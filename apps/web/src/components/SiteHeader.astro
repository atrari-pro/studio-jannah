---
import { navigation } from "@studio-jannah/shared";
import Logo from "./Logo.astro";
import { withBase } from "../lib/paths";

interface Props {
  overInk?: boolean;
}

const { overInk = false } = Astro.props;
---

<header class:list={["header", overInk && "is-over-ink"]} data-header>
  <div class="wrap header__inner">
    <a
      class="header__logo"
      href={withBase("/")}
      data-track-cta="header_logo_home"
      data-track-label="Studio Jannah"
    >
      <Logo variant="full" size={30} />
    </a>

    <button
      type="button"
      class="header__menu"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Ouvrir le menu"
    >
      <span></span>
      <span></span>
    </button>

    <nav class="nav" id="site-nav" data-nav aria-label="Principale">
      {
        navigation.map((item) =>
          "children" in item ? (
            <div class="nav__item">
              <a href={withBase(item.href)} class="nav__trigger">
                {item.label}
                <svg class="nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path
                    d="M1 1l4 4 4-4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <div class="nav__dropdown">
                {item.children.map((child) => (
                  <a
                    href={withBase(child.href)}
                    class="nav__dropdown-item"
                    data-track-cta={`header_nav_${child.label.toLowerCase().replace(/\s+/g, "_")}`}
                    data-track-label={child.label}
                  >
                    <span class="nav__dropdown-title">{child.label}</span>
                    <span class="nav__dropdown-desc">{child.description}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={withBase(item.href)}>{item.label}</a>
          ),
        )
      }
      <a
        class="btn btn-primary nav__cta-mobile"
        href={withBase("/contact")}
        data-track-cta="header_contact_mobile"
        data-track-label="Parler du signal"
      >
        Parler du signal
      </a>
    </nav>

    <a
      class="btn btn-primary header__cta"
      href={withBase("/contact")}
      data-track-cta="header_contact"
      data-track-label="Parler du signal"
    >
      Parler du signal
    </a>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-nav]");

  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 12);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const setOpen = (open) => {
    header?.classList.toggle("is-nav-open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    toggle?.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
    document.body.classList.toggle("nav-open", open);
  };

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    setOpen(open);
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style is:global>
  body.nav-open {
    overflow: hidden;
  }
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in oklab, var(--sj-paper) 88%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s var(--sj-ease),
      border-color 0.3s var(--sj-ease),
      box-shadow 0.3s var(--sj-ease);
  }

  .header.is-scrolled,
  .header.is-nav-open {
    background: color-mix(in oklab, var(--sj-paper) 96%, transparent);
    border-bottom-color: var(--sj-line);
  }

  /*
   * `backdrop-filter` sur .header agit comme `filter` : il crée un containing
   * block pour ses descendants `position: fixed` (bug WebKit historique,
   * reproduit aussi sous Chromium). Résultat en mobile : .nav (fixed, inset:0)
   * se cale sur la boîte du header (~72px) au lieu du viewport entier — le
   * menu ouvert affiche une bande vide, les liens sont clippés hors champ.
   * On coupe le blur pendant l'ouverture du nav pour que inset:0 se
   * recalcule bien contre le viewport ; le fond ~96% opaque au-dessus rend
   * la perte du blur imperceptible.
   */
  .header.is-nav-open {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header.is-scrolled {
    box-shadow: 0 1px 0 color-mix(in oklab, var(--sj-ink) 4%, transparent);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.25s ease;
    z-index: 2;
  }

  .header__logo:hover {
    opacity: 0.82;
    color: inherit;
  }

  .header__menu {
    margin-left: auto;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--sj-line);
    background: transparent;
    cursor: pointer;
    border-radius: var(--sj-radius);
  }

  .header__menu span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--sj-ink);
    transition: transform 0.3s var(--sj-ease);
  }

  .header.is-nav-open .header__menu span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .header.is-nav-open .header__menu span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .nav {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    position: fixed;
    inset: 0;
    padding: 5.5rem 1.5rem 2rem;
    background: var(--sj-paper);
    z-index: 1;
  }

  .header.is-nav-open .nav {
    display: flex;
  }

  .nav a,
  .nav__trigger {
    position: relative;
    text-decoration: none;
    color: var(--sj-ink);
    font-size: 1.15rem;
    font-weight: 600;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--sj-line);
  }

  .nav__cta-mobile {
    margin-top: 1.25rem;
    width: fit-content;
    border-bottom: 0 !important;
  }

  .header__cta {
    display: none;
  }

  /* Item "Signal" (Bibliothèque d'expertises + Blog) — menu déroulant.
     Mobile : le trigger navigue normalement (/expertises), les deux
     destinations réelles restent visibles en dessous, en retrait — pas de
     JS, pas de clic supplémentaire pour découvrir qu'il y a deux formats
     (le problème remonté sur la 1re version fusionnée). */
  .nav__item {
    display: contents;
  }

  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .nav__chevron {
    flex-shrink: 0;
    color: var(--sj-muted);
  }

  .nav__dropdown {
    display: grid;
    gap: 0.15rem;
    margin: 0 0 0.5rem 0.9rem;
    padding-left: 0.85rem;
    border-left: 1px solid var(--sj-line);
  }

  .nav__dropdown-item {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.55rem;
    text-decoration: none;
  }

  .nav__dropdown-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sj-ink);
  }

  .nav__dropdown-desc {
    font-size: 0.8rem;
    color: var(--sj-muted);
  }

  @media (min-width: 860px) {
    .header__menu {
      display: none;
    }

    .nav {
      display: flex;
      position: static;
      inset: auto;
      flex-direction: row;
      align-items: center;
      margin-left: auto;
      padding: 0;
      background: transparent;
      gap: 0.15rem 1.5rem;
      font-size: 0.9rem;
      font-weight: 500;
    }

    .nav a,
    .nav__trigger {
      color: var(--sj-muted);
      font-size: 0.9rem;
      font-weight: 500;
      padding-block: 0.35rem;
      border-bottom: 0;
    }

    .nav a::after,
    .nav__trigger::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 1.5px;
      background: var(--sj-signal);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s var(--sj-ease);
    }

    .nav a:hover,
    .nav__trigger:hover {
      color: var(--sj-ink);
    }

    .nav a:hover::after,
    .nav__trigger:hover::after {
      transform: scaleX(1);
    }

    .nav__cta-mobile {
      display: none;
    }

    /* Dropdown "Signal" — révélé au survol/focus, sans JS (voir aussi le
       fallback mobile plus haut, toujours déplié). .nav__dropdown est
       collé au trigger (top:100%, aucun espace entre les deux) : pas de
       dead zone à traverser en descendant la souris vers le panneau. */
    .nav__item {
      display: block;
      position: relative;
    }

    .nav__chevron {
      transition: transform 0.2s var(--sj-ease);
    }

    .nav__item:hover .nav__chevron,
    .nav__item:focus-within .nav__chevron {
      transform: rotate(180deg);
    }

    .nav__dropdown {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      margin: 0;
      padding: 0.6rem;
      min-width: 15rem;
      border: 1px solid var(--sj-line);
      border-radius: var(--sj-radius);
      background: var(--sj-paper-elevated);
      box-shadow: 0 12px 28px color-mix(in oklab, var(--sj-ink) 12%, transparent);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.2s var(--sj-ease),
        visibility 0.2s;
    }

    .nav__item:hover .nav__dropdown,
    .nav__item:focus-within .nav__dropdown {
      opacity: 1;
      visibility: visible;
    }

    .nav__dropdown-item {
      padding: 0.55rem 0.65rem;
      border-radius: calc(var(--sj-radius) - 4px);
    }

    .nav__dropdown-item:hover {
      background: color-mix(in oklab, var(--sj-garden) 8%, transparent);
    }

    .header__cta {
      display: inline-flex;
      margin-left: 1.75rem;
      min-height: 2.55rem;
      padding-inline: 1.1rem;
      font-size: 0.85rem;
    }

    .header__inner {
      min-height: 4.5rem;
    }
  }

  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) :global(.sj-logo) {
    color: #f7f8f7;
  }

  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) :global(.sj-logo__pulse--1),
  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) :global(.sj-logo__pulse--2),
  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) :global(.sj-logo__pulse--3) {
    color: color-mix(in oklab, #f7f8f7 80%, var(--sj-garden-bright));
  }

  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .header__menu {
    border-color: color-mix(in oklab, #f7f8f7 28%, transparent);
  }

  .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .header__menu span {
    background: #f7f8f7;
  }

  @media (min-width: 860px) {
    .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .nav a,
    .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .nav__trigger {
      color: color-mix(in oklab, #f7f8f7 72%, transparent);
    }

    .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .nav a:hover,
    .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .nav__trigger:hover {
      color: #f7f8f7;
    }

    .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .header__cta {
      background: transparent;
      color: #f7f8f7;
      box-shadow: none;
      border-color: color-mix(in oklab, #f7f8f7 32%, transparent);
    }

    .header.is-over-ink:not(.is-scrolled):not(.is-nav-open) .header__cta:hover {
      background: color-mix(in oklab, #f7f8f7 8%, transparent);
      color: #f7f8f7;
      border-color: #f7f8f7;
    }
  }
</style>
