---
/**
 * TrackingBoot — listeners page (CTA, outbound, page_view).
 * S’appuie sur window.sj (datalayer.js) : pas de réinit DL, nomenclature sj_*.
 * Scroll depth retiré (v1.2.0) : signal jamais exploité, redondant avec le
 * scroll auto-collecté par GA4 Enhanced Measurement côté GTM.
 */
interface Props {
  pagePath: string;
  pageTitle: string;
  pageType?: string;
}

const { pagePath, pageTitle, pageType = "other" } = Astro.props;
---

<script define:vars={{ pagePath, pageTitle, pageType }} is:inline>
  (function () {
    function api() {
      return window.sj;
    }

    function push(hit) {
      if (api() && api().push) api().push(hit);
      else if (window.sjTrack) window.sjTrack(hit);
    }

    if (api() && api().setContext) {
      api().setContext({
        page_path: pagePath,
        page_title: pageTitle,
        page_type: pageType,
      });
    }

    // page_view une fois (dédup runtime) — mis en file si pas encore de consent.
    // Nom standard GA4/GTM (pas sj_page_view) — voir docs/TRACKING_DATALAYER.md
    // pour le point d'attention côté tag de configuration GA4.
    push({
      event: "page_view",
      page_path: pagePath,
      page_title: pageTitle,
      page_type: pageType,
    });

    document.addEventListener(
      "click",
      function (e) {
        var t = e.target;
        if (!t || !t.closest) return;

        var cta = t.closest("[data-track-cta]");
        if (cta) {
          var ctaId = cta.getAttribute("data-track-cta") || "unknown_cta";
          var zone = ctaId.split("_")[0] || "unknown";
          push({
            event: "sj_cta_click",
            cta_id: ctaId,
            cta_label: (cta.getAttribute("data-track-label") || cta.textContent || "")
              .trim()
              .slice(0, 120),
            cta_zone: zone,
            page_path: pagePath,
            page_type: pageType,
          });
        }

        var a = t.closest("a[href]");
        if (a && a.href) {
          try {
            var url = new URL(a.href, location.href);
            if (url.origin !== location.origin && /^https?:$/.test(url.protocol)) {
              push({
                event: "sj_outbound_click",
                link_url: url.href,
                link_domain: url.hostname,
                page_path: pagePath,
                page_type: pageType,
              });
            }
          } catch (err) {}
        }
      },
      true,
    );
  })();
</script>
