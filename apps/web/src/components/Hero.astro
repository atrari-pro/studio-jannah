---
import { site } from "@studio-jannah/shared";
import Logo from "./Logo.astro";
import { withBase } from "../lib/paths";
---

<section class="hero" aria-labelledby="hero-brand">
  <div class="hero__atmosphere" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <p class="hero__watermark" aria-hidden="true">Signal</p>
  <div class="wrap hero__content">
    <div class="hero__brand" id="hero-brand">
      <Logo variant="full" size={48} inverted />
    </div>
    <div class="hero__rule" aria-hidden="true"></div>
    <p class="hero__tag">{site.tagline}</p>
    <h1>
      Mesure fiable.<br />
      <span>Décisions actionnables.</span>
    </h1>
    <p class="hero__lead">
      Collecte, tracking, CRO et data/IA — pour que vos leviers reposent sur un
      signal que l’on peut croire.
    </p>
    <div class="hero__cta">
      <a
        class="btn btn-primary"
        href={withBase("/contact")}
        data-track-cta="hero_cta_contact"
        data-track-label="Échanger"
      >
        Échanger
      </a>
      <a
        class="btn btn-ghost"
        href={withBase("/#expertises")}
        data-track-cta="hero_cta_expertises"
        data-track-label="Voir les expertises"
      >
        Voir les expertises
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(78dvh, 42rem);
    display: grid;
    align-items: end;
    padding-block: 7rem 4.5rem;
    overflow: hidden;
    color: #f7f8f7;
    background: var(--sj-ink);
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 50% at 18% 20%,
        color-mix(in oklab, var(--sj-garden) 38%, transparent),
        transparent 60%
      ),
      radial-gradient(
        ellipse 45% 35% at 92% 80%,
        color-mix(in oklab, var(--sj-signal) 10%, transparent),
        transparent 55%
      ),
      linear-gradient(165deg, var(--sj-ink) 0%, var(--sj-ink-soft) 60%, #071410 100%);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.09;
    background-image:
      linear-gradient(color-mix(in oklab, var(--sj-paper) 20%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--sj-paper) 20%, transparent) 1px, transparent 1px);
    background-size: 5rem 5rem;
    mask-image: radial-gradient(ellipse 70% 60% at 75% 35%, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .hero__watermark {
    position: absolute;
    right: -2%;
    bottom: -6%;
    margin: 0;
    font-family: var(--sj-font-display);
    font-size: clamp(6rem, 22vw, 16rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: color-mix(in oklab, #f7f8f7 5%, transparent);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 38rem;
    animation: sj-rise 0.9s var(--sj-ease) both;
  }

  .hero__brand {
    margin: 0 0 1.15rem;
  }

  .hero__rule {
    width: 0;
    height: 2px;
    margin: 0 0 1.25rem;
    background: linear-gradient(90deg, var(--sj-signal), transparent);
    animation: sj-hero-rule 1.1s var(--sj-ease) 0.2s forwards;
  }

  @keyframes sj-hero-rule {
    to {
      width: min(9rem, 40%);
    }
  }

  .hero__tag {
    margin: 0 0 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--sj-signal) 80%, #f7f8f7);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 7vw, 4.15rem);
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .hero h1 span {
    font-weight: 500;
    opacity: 0.86;
  }

  .hero__lead {
    font-size: clamp(1.02rem, 2vw, 1.15rem);
    color: color-mix(in oklab, #f7f8f7 76%, transparent);
    max-width: 30rem;
    margin-bottom: 1.75rem;
    line-height: 1.55;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero .btn-primary {
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--sj-garden-bright) 35%, transparent);
  }

  .hero .btn-ghost {
    border-color: color-mix(in oklab, #f7f8f7 30%, transparent);
    color: #f7f8f7;
  }

  .hero .btn-ghost:hover {
    border-color: #f7f8f7;
    color: #f7f8f7;
    background: color-mix(in oklab, #f7f8f7 8%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__rule {
      animation: none;
      width: 8rem;
    }
  }
</style>
