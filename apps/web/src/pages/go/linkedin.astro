---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "@studio-jannah/shared";

const source = "linkedin";
import { withBase } from "../../lib/paths";

---

<BaseLayout
  title={`Depuis LinkedIn — ${site.name}`}
  description="Landing acquisition LinkedIn — Studio Jannah."
  path="/go/linkedin"
  pageType="acquisition"
  contentGroup="acquisition"
>
  <section class="section wrap go">
    <p class="eyebrow">Acquisition · LinkedIn</p>
    <h1>Bienvenue depuis LinkedIn</h1>
    <p class="section-lead">
      Landing dédiée posts / pubs LinkedIn. Event
      <code>sj_campaign_land</code> (contrat DL v1).
    </p>
    <div class="go__cta">
      <a
        class="btn btn-primary"
        href={withBase("/contact")}
        data-track-cta="acq_linkedin_cta_contact"
        data-track-label="Échanger"
      >
        Échanger
      </a>
      <a
        class="btn btn-ghost"
        href={withBase("/a-propos")}
        data-track-cta="acq_linkedin_cta_about"
        data-track-label="À propos"
      >
        À propos
      </a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ source }}>
  const params = new URLSearchParams(window.location.search);
  (window.sj?.push || window.sjTrack)?.({
    event: "sj_campaign_land",
    page_path: "/go/linkedin",
    page_type: "acquisition",
    content_group: "acquisition",
    campaign_source: params.get("utm_source") || source,
    campaign_medium: params.get("utm_medium") || "social",
    campaign_name: params.get("utm_campaign") || "linkedin_default",
    campaign_content: params.get("utm_content") || undefined,
  });
</script>

<style>
  .go h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .go__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
