---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "@studio-jannah/shared";
import { withBase } from "../lib/paths";

/** Bridge vitrine → app démo (Vite). En prod: URL app ou même origin reverse-proxy. */
const appDevUrl = "http://localhost:5173";

---

<BaseLayout
  title={`App démo — ${site.name}`}
  description="Pont vers l’app démo PWA / Capacitor — Studio Jannah."
  path="/app"
  pageType="app_bridge"
  contentGroup="product"
>
  <section class="section wrap app-bridge">
    <p class="eyebrow">Product / Funnel · Mobile</p>
    <h1>App démo</h1>
    <p class="section-lead">
      Surface interactive (funnels, wizards) destinée à la PWA puis Capacitor pour
      démos entretien. En local : lancer <code>pnpm dev:app</code>.
    </p>
    <div class="app-bridge__actions">
      <a
        class="btn btn-primary"
        href={appDevUrl}
        data-track-cta="app_open"
        data-track-label="Ouvrir l’app démo"
        rel="noopener"
      >
        Ouvrir l’app démo
      </a>
      <a
        class="btn btn-ghost"
        href={withBase("/contact")}
        data-track-cta="app_contact"
        data-track-label="Demander une démo"
      >
        Demander une démo
      </a>
    </div>
    <ul class="app-bridge__notes">
      <li>Tracking funnel_step prévu dans l’app</li>
      <li>PWA manifest à activer phase 2</li>
      <li>Capacitor wrap = phase démo mobile téléchargeable</li>
    </ul>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .app-bridge__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .app-bridge__notes {
    color: var(--sj-muted);
    font-size: 0.95rem;
  }
</style>
