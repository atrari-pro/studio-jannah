---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { expertiseDomains, expertiseCategories, site } from "@studio-jannah/shared";
import { withBase } from "../../lib/paths";

const published = await getCollection("expertises", ({ data }) => data.status === "published");
const expertises = site.expertises;

const domainStats = expertiseDomains.map((domain) => {
  const count = published.filter((e) => e.id.startsWith(`${domain.id}/`)).length;
  const categoryCount = expertiseCategories[domain.id].length;
  return { ...domain, count, categoryCount };
});

// Hub unique (fusion Blog + Expertises, voir navigation dans
// @studio-jannah/shared) : la bibliothèque reste la vedette (grille de
// domaines ci-dessus), le blog garde sa page complète sous /blog — ici,
// juste les 3 signaux les plus récents pour que l'un mène naturellement
// à l'autre, sans dupliquer la logique de filtre/recherche de /blog.
const recentInsights = (await getCollection("insights", ({ data }) => data.status === "published"))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const siteRoot = (Astro.site?.toString() || site.url).replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${expertises.name} — ${site.name}`,
  description: expertises.tagline,
  url: `${siteRoot}/expertises`,
  isPartOf: { "@type": "WebSite", name: site.name, url: `${siteRoot}/` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: domainStats.map((d, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${siteRoot}/expertises/${d.id}`,
      name: d.label,
    })),
  },
};
---

<BaseLayout
  title={`${expertises.name} — ${site.name}`}
  description={expertises.tagline}
  path="/expertises"
  pageType="expertises_hub"
  jsonLd={jsonLd}
>
  <div class="expertises-hub">
    <div class="wrap">
      <header class="expertises-hub__cover">
        <p class="eyebrow">{expertises.name}</p>
        <h1>{expertises.headline}</h1>
        <p class="expertises-hub__lead">{expertises.tagline}</p>
      </header>

      <p class="expertises-hub__section-label">Bibliothèque d'expertises — guides de référence</p>
      <ul class="expertises-hub__grid">
        {
          domainStats.map((domain) => (
            <li>
              <a
                class="expertises-hub__card"
                href={withBase(`/expertises/${domain.id}`)}
                data-track-cta={`expertises_hub_${domain.id}`}
                data-track-label={domain.label}
              >
                <span class="expertises-hub__card-title">{domain.label}</span>
                <span class="expertises-hub__card-tagline">{domain.tagline}</span>
                <span class="expertises-hub__card-foot">
                  {domain.categoryCount} catégorie{domain.categoryCount > 1 ? "s" : ""} ·{" "}
                  {domain.count} article{domain.count > 1 ? "s" : ""}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      {
        recentInsights.length > 0 && (
          <div class="expertises-hub__blog">
            <div class="expertises-hub__blog-head">
              <p class="expertises-hub__section-label">Signal — dernières lectures</p>
              <a
                class="expertises-hub__blog-all"
                href={withBase("/blog")}
                data-track-cta="expertises_hub_blog_all"
                data-track-label="Tout le blog"
              >
                Tout le blog →
              </a>
            </div>
            <ul class="expertises-hub__blog-grid">
              {recentInsights.map((item) => (
                <li>
                  <BlogCard
                    id={item.id}
                    title={item.data.title}
                    description={item.data.description}
                    rubrique={item.data.rubrique}
                    format={item.data.format}
                    ctaZone="expertises_hub_blog"
                  />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .expertises-hub {
    background:
      radial-gradient(ellipse 80% 50% at 10% 0%, color-mix(in oklab, var(--sj-garden) 18%, transparent), transparent 55%),
      linear-gradient(180deg, var(--sj-ink) 0%, var(--sj-ink-soft) 55%, #0a1613 100%);
    color: #f3f0e8;
    min-height: 70vh;
    padding: 2rem 0 4.5rem;
  }

  .expertises-hub__cover h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    max-width: 20ch;
    color: #f3f0e8;
    margin: 0.15rem 0 0.75rem;
  }

  .expertises-hub__lead {
    margin: 0 0 2.5rem;
    max-width: 38rem;
    color: color-mix(in oklab, #f3f0e8 72%, transparent);
  }

  .expertises-hub__section-label {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 650;
    color: color-mix(in oklab, #f3f0e8 55%, transparent);
  }

  .expertises-hub__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 720px) {
    .expertises-hub__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .expertises-hub__blog {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in oklab, #f3f0e8 12%, transparent);
  }

  .expertises-hub__blog-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 0.85rem;
  }

  .expertises-hub__blog-head .expertises-hub__section-label {
    margin: 0;
  }

  @media (min-width: 480px) {
    .expertises-hub__blog-head {
      flex-wrap: nowrap;
      justify-content: space-between;
    }
  }

  .expertises-hub__blog-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: #3d8f78;
    text-decoration: none;
    white-space: nowrap;
  }

  .expertises-hub__blog-all:hover {
    color: color-mix(in oklab, #3d8f78 70%, #f3f0e8);
  }

  .expertises-hub__blog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 720px) {
    .expertises-hub__blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .expertises-hub__card {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem 1.4rem;
    border: 1px solid color-mix(in oklab, #f3f0e8 12%, transparent);
    background: color-mix(in oklab, #101916 72%, transparent);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.25s var(--sj-ease),
      background 0.25s var(--sj-ease);
  }

  .expertises-hub__card:hover {
    border-color: color-mix(in oklab, var(--sj-signal) 45%, #f3f0e8);
    background: color-mix(in oklab, #16221c 80%, transparent);
    color: inherit;
  }

  .expertises-hub__card-title {
    /* Manrope, pas Syne — même raison que BlogCard.astro (voir son
       commentaire) : Syne répétée sur du texte de carte devient dense
       plutôt que "pro", même à cette taille plus généreuse (niveau hub). */
    font-family: var(--sj-font-body);
    font-weight: 700;
    font-size: 1.4rem;
    color: #f3f0e8;
  }

  .expertises-hub__card-tagline {
    font-size: 0.95rem;
    line-height: 1.5;
    color: color-mix(in oklab, #f3f0e8 65%, transparent);
  }

  .expertises-hub__card-foot {
    margin-top: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #3d8f78;
  }
</style>
