---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "@studio-jannah/shared";
---

<BaseLayout
  title={`Réponses AO — ${site.name}`}
  description="Slot réponses type appel d’offres — Studio Jannah."
  path="/ao"
  pageType="ao"
  contentGroup="corporate"
>
  <section class="section wrap">
    <p class="eyebrow">Slot Innovation / Delivery</p>
    <h1>Réponses AO</h1>
    <p class="section-lead">
      Zone prévue pour dossiers type appel d’offres / briefs (entretien, prospects).
      Structure en place ; contenus fictifs à venir puis remplacement réel.
    </p>
    <article class="ao-stub">
      <h2>Exemple de structure (stub)</h2>
      <ol>
        <li>Compréhension du besoin</li>
        <li>Approche mesure & tracking</li>
        <li>Livrables & jalons</li>
        <li>Preuves / contextes de marques</li>
      </ol>
    </article>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .ao-stub {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sj-line);
    max-width: 36rem;
  }

  .ao-stub h2 {
    font-size: 1.2rem;
  }

  .ao-stub ol {
    color: var(--sj-muted);
  }
</style>
