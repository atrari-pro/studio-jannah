---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RefsStage from "../components/RefsStage.astro";
import Expertises from "../components/Expertises.astro";
import Missions from "../components/Missions.astro";
import ContentBlocks from "../components/ContentBlocks.astro";
import Signature from "../components/Signature.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "@studio-jannah/shared";
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description="Mesure marketing fiable, tracking, CRO et data/IA. Studio Jannah — atelier du signal."
  path="/"
  pageType="home"
  contentGroup="corporate"
>
  <Hero />
  <Expertises />
  <Missions />
  <RefsStage />
  <ContentBlocks />
  <Signature />
  <CtaBand />
</BaseLayout>
