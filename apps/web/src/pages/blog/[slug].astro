---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "@studio-jannah/shared";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const entries = await getCollection("insights", ({ data }) => data.status === "published");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const blog = site.blog;
const video = entry.data.video;
---

<BaseLayout
  title={`${entry.data.title} — ${blog.name}`}
  description={entry.data.description}
  path={`/blog/${entry.id}`}
  pageType="blog_article"
>
  <article class="section wrap article">
    <p class="eyebrow">
      <a href={withBase("/blog")} data-track-cta="blog_crumb" data-track-label={blog.name}>{blog.name}</a>
    </p>
    <h1>{entry.data.title}</h1>
    <p class="article__hook">{entry.data.hook}</p>
    <p class="article__meta">
      <time datetime={entry.data.publishedAt.toISOString()}
        >{
          entry.data.publishedAt.toLocaleDateString("fr-FR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }</time
      >
      <span>· {entry.data.format === "video" ? "Vidéo" : "Texte"}</span>
      {
        entry.data.tags.length > 0 && (
          <span>· {entry.data.tags.join(" · ")}</span>
        )
      }
    </p>
    {
      video && (
        <figure class="article__media">
          <video
            controls
            playsinline
            preload="metadata"
            src={withBase(video.src)}
            poster={video.poster ? withBase(video.poster) : undefined}
          />
          {video.caption && <figcaption>{video.caption}</figcaption>}
        </figure>
      )
    }
    <div class="article__body">
      <Content />
    </div>
    {
      entry.data.sources.length > 0 && (
        <aside class="article__sources">
          <h2>Références</h2>
          <ul>
            {entry.data.sources.map((s) => (
              <li>
                <a
                  href={s.url}
                  rel="noopener noreferrer"
                  data-track-cta={`blog_src_${entry.id}`}
                  data-track-label={s.label}
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
    <p class="article__cta">
      <a
        class="btn btn-primary"
        href={withBase("/contact")}
        data-track-cta="blog_contact"
        data-track-label="Discuter mesure"
      >
        Discuter mesure
      </a>
      <a
        class="btn btn-ghost"
        href={withBase("/blog")}
        data-track-cta="blog_back"
        data-track-label="Retour au Blog"
      >
        Retour au Blog
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .article h1 {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    max-width: 40rem;
  }

  .eyebrow a {
    text-decoration: none;
    color: var(--sj-garden);
  }

  .article__hook {
    font-size: 1.15rem;
    color: var(--sj-muted);
    max-width: 38rem;
  }

  .article__meta {
    font-size: 0.9rem;
    color: var(--sj-muted);
  }

  .article__media {
    margin: 1.75rem 0 0;
    max-width: 42rem;
  }

  .article__media video {
    display: block;
    width: 100%;
    background: var(--sj-ink);
    border: 1px solid var(--sj-line);
  }

  .article__media figcaption {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--sj-muted);
  }

  .article__body {
    max-width: 40rem;
    margin-top: 2rem;
  }

  .article__body :global(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
  }

  /* Images insérées depuis l'admin (voir docs/ADMIN_LEADS.md) — une image
     seule reste un <img> normal, 2+ consécutives sont regroupées en galerie
     par rehype-article-images.mjs selon leur nombre. */
  .article__body :global(img) {
    display: block;
    width: 100%;
    border-radius: var(--sj-radius);
    border: 1px solid var(--sj-line);
    margin: 1.75rem 0;
  }

  .article__body :global(.article-gallery) {
    display: grid;
    gap: 0.75rem;
    margin: 1.75rem 0;
  }

  .article__body :global(.article-gallery--2),
  .article__body :global(.article-gallery--3) {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .article__body :global(.article-gallery--4) {
    grid-template-columns: repeat(2, 1fr);
  }

  .article__body :global(.article-figure) {
    margin: 0;
  }

  .article__body :global(.article-figure img) {
    margin: 0;
    height: 100%;
    object-fit: cover;
  }

  .article__sources {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sj-line);
    max-width: 40rem;
  }

  .article__sources h2 {
    font-size: 1.1rem;
  }

  .article__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
