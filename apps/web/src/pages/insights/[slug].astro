---
/**
 * Redirect legacy /insights/<slug> → /blog/<slug>
 * Toutes les URLs historiques doivent rediriger, pas seulement la première
 * migrée à la main — sinon 404 silencieux pour tout ancien lien indexé/partagé.
 */
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("insights");
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
return Astro.redirect(`/blog/${slug}`, 301);
---
