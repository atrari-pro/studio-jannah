# Google Tag Manager — chargé UNIQUEMENT via la CMP (tarteaucitron + Consent Mode v2)
# Ne pas coller le snippet officiel dans le HTML : il bypasserait le consentement.
PUBLIC_GTM_ID=GTM-XXXXXXX

# Supabase — Project Settings → API (valeurs locales dans .env, jamais commit)
# URL API : https://<project-ref>.supabase.co  — PAS https://supabase.com/dashboard/...
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
